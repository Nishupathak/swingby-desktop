{
  "name": "swingby",
  "version": "1.0.0",
  "description": "A web-swinging hero that reminds you of things, on top of any app on your computer.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^31.0.0",
